# Copier vers openwa/.env avant de lancer `docker compose -f openwa/docker-compose.yml up -d`.
# Ce fichier ne configure QUE le conteneur OpenWA. Les variables que l'application
# Next.js consomme (OPENWA_BASE_URL / OPENWA_API_KEY / OPENWA_SESSION_ID) vont, elles,
# dans le .env.local à la racine du projet.

# Clé maîtresse OpenWA : elle déverrouille le tableau de bord et l'API.
# Générer une valeur aléatoire, par ex. :  openssl rand -hex 32
API_MASTER_KEY=changez-moi-avec-une-valeur-aleatoire-longue

# Port d'écoute local du tableau de bord / de l'API (défaut 2785).
OPENWA_PORT=2785

# Limitation d'envoi (fenêtre glissante). Rester bas : WhatsApp restreint les
# comptes qui envoient en rafale depuis un client non officiel.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
