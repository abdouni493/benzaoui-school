# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables. NEVER commit .env.local.

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# service_role secret — server-only, required by /api/admin/users and by the
# WhatsApp message log / webhook. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- WhatsApp gateway (Evolution API, self-hosted) ---------------------------
# Open-source gateway driving a real WhatsApp Web session (Baileys engine).
# It needs a process that stays up; Vercel is serverless and cannot host it.
# That means neither a VPS nor a paid service — evolution/README.md covers:
#   B. Tailscale Funnel on the school PC — FREE, no domain needed   (IN USE)
#   C. Cloudflare Tunnel on the school PC — free, but needs a domain
#   D. Railway — managed containers, 7-10 $/mo, keeps running PC off
#   E. VPS     — the classic route
# Only EVOLUTION_BASE_URL changes between them. With B and C the gateway lives
# on the school PC: switched off or asleep, nothing is sent — run
# evolution/keep-alive.ps1 once to lock that machine into continuous service.
#
# ALL values below are SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_:
# that would ship the gateway key to every visitor's browser.

# Root URL of the gateway, no trailing slash. Examples:
#   Tailscale Funnel  https://benzaoui-wa.tailXXXX.ts.net      (option B)
#   Cloudflare Tunnel https://wa.your-domain.example           (option C)
#   Railway           https://benzaoui-wa-production.up.railway.app
#   Local             http://localhost:8081
# Some installs serve the API under /api — check which one answers:
#   curl -s https://wa.your-domain.example/instance/fetchInstances -H "apikey: KEY"
# Must match the gateway's own SERVER_URL exactly, or delivery webhooks are
# rejected with 403 (the app compares the two hosts).
EVOLUTION_BASE_URL=https://wa.your-domain.example

# Global API key of the gateway. Must match AUTHENTICATION_API_KEY in
# evolution/.env (the value Docker starts the gateway with). Generate with:
#   openssl rand -hex 32
EVOLUTION_API_KEY=YOUR-EVOLUTION-GLOBAL-API-KEY

# Name of the WhatsApp session on the gateway. Any label; one per phone number.
EVOLUTION_INSTANCE=benzaoui

# Shared secret proving that an incoming webhook really comes from the gateway.
# The gateway does NOT sign its webhooks, so this token is the main barrier —
# without it, anyone could POST fake delivery statuses. Use a DIFFERENT random
# value from EVOLUTION_API_KEY:
#   openssl rand -hex 32
EVOLUTION_WEBHOOK_TOKEN=YOUR-RANDOM-WEBHOOK-SECRET

# Optional: full public URL the gateway must call back.
#
# LOCAL DEV ONLY. Required here because the gateway runs in Docker and the app
# on the host:
#   EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3000/api/whatsapp/webhook
#
# NEVER set this on Vercel. Left unset, the app derives the callback from its
# own production domain. Copied over from this file by mistake, the gateway
# would call back a machine it cannot reach: messages still go out, but no
# delivery status and no parent reply ever comes back — with no visible error.
# EVOLUTION_WEBHOOK_URL=

# Optional: public origin of the app, used to build the webhook URL when the
# Vercel variables are not available (custom domain, self-hosting).
# NEXT_PUBLIC_SITE_URL=https://school.example
