# Copy to .env.local for local dev. On Vercel, set these three in
# Project Settings -> Environment Variables.

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# service_role secret — server-only, required by /api/admin/users
# (staff/student/parent account creation). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Passerelle WhatsApp (OpenWA) -------------------------------------------
# Service séparé, à démarrer soi-même : voir openwa/README.md.
# Server-only : ne JAMAIS préfixer par NEXT_PUBLIC_, la clé ouvre l'envoi de
# messages depuis le numéro WhatsApp de l'école.
# Sans ces trois variables, les boutons WhatsApp affichent une erreur explicite.
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=YOUR-OPENWA-OPERATOR-KEY
OPENWA_SESSION_ID=YOUR-OPENWA-SESSION-UUID
