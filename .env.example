# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables. NEVER commit .env.local.

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# service_role secret — server-only, required by /api/admin/users and by the
# WhatsApp message log / webhook. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# Official Meta WhatsApp Business Platform. All values are SERVER-ONLY — never
# prefix any of them with NEXT_PUBLIC_. See README.md for the full setup guide.
# Placeholders only below: put the real values in .env.local (git-ignored).

# Meta App -> Settings -> Basic (App ID + App Secret). App Secret signs webhooks.
META_APP_ID=YOUR-META-APP-ID
META_APP_SECRET=YOUR-META-APP-SECRET

# WhatsApp Manager. The Phone Number ID is the NUMERIC id shown next to your
# business number (NOT the phone number itself). WABA ID = WhatsApp Business
# Account ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR-WABA-ID
WHATSAPP_PHONE_NUMBER_ID=YOUR-PHONE-NUMBER-ID

# System User permanent access token (Business Settings -> System Users).
# Opens sending from the school's WhatsApp number — treat as a secret.
WHATSAPP_ACCESS_TOKEN=YOUR-PERMANENT-ACCESS-TOKEN

# Any random string you choose; must match the value entered in the Meta webhook
# configuration. Used only to verify the webhook subscription GET request.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=YOUR-WEBHOOK-VERIFY-TOKEN

# Graph API version used for all calls. Bump to the current supported version.
WHATSAPP_API_VERSION=v21.0

# --- Approved WhatsApp message templates -------------------------------------
# EXACT names of the templates you created and Meta approved (WhatsApp Manager
# -> Message templates). Alerts fail with a clear error until these are set.
# Each template body must expose the variables, in this order:
#   {{1}} = student full name, {{2}} = amount (e.g. "1 500 DA"), {{3}} = school name
WHATSAPP_TEMPLATE_BALANCE_DEBT=YOUR-DEBT-TEMPLATE-NAME
WHATSAPP_TEMPLATE_BALANCE_EMPTY=YOUR-EMPTY-BALANCE-TEMPLATE-NAME
WHATSAPP_TEMPLATE_BALANCE_LOW=YOUR-LOW-BALANCE-TEMPLATE-NAME
WHATSAPP_TEMPLATE_REGISTRATION_DUE=YOUR-REGISTRATION-TEMPLATE-NAME

# Optional: override the Meta language code that must match your approved
# templates' language (defaults: fr / ar).
# WHATSAPP_TEMPLATE_LANG_FR=fr
# WHATSAPP_TEMPLATE_LANG_AR=ar
