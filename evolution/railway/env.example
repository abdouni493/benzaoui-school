# =============================================================================
# Variables du service « evolution » sur Railway (hébergement SANS VPS).
#
# À coller dans Railway → service evolution → Variables → « Raw Editor ».
# Les valeurs entre ${{ }} sont des RÉFÉRENCES Railway : elles se remplissent
# toutes seules à partir des autres services du projet — ne pas les recopier
# à la main, ne pas y mettre le mot de passe en clair.
#
# ⚠️ Ce fichier est un MODÈLE commité. N'y écrire aucun secret réel.
# =============================================================================

# --- Identité publique de la passerelle --------------------------------------
# DOIT être exactement le domaine servi par Railway (Settings → Networking →
# Public Networking), en https, sans slash final. C'est la valeur renvoyée dans
# le champ `server_url` des webhooks, que /api/whatsapp/webhook compare à
# EVOLUTION_BASE_URL côté Vercel : une différence et tous les statuts de remise
# sont rejetés en 403.
SERVER_URL=https://VOTRE-SERVICE.up.railway.app

# Evolution écoute sur SERVER_PORT ; Railway route le trafic public vers PORT.
# Les deux doivent donc désigner le même port.
SERVER_PORT=8080
PORT=8080

# --- Authentification ---------------------------------------------------------
# Clé globale de la passerelle. Générer une valeur aléatoire (PowerShell) :
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# La MÊME valeur doit être mise dans Vercel sous le nom EVOLUTION_API_KEY.
AUTHENTICATION_API_KEY=REMPLACER-PAR-UNE-CLE-ALEATOIRE-DE-64-CARACTERES
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# --- Base de données ----------------------------------------------------------
# Ajouter un service Postgres au projet Railway, puis laisser ces références
# telles quelles. `?schema=public` est exigé par Prisma, côté Evolution.
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=${{Postgres.DATABASE_URL}}?schema=public
DATABASE_SAVE_DATA_INSTANCE=true
# Le contenu des messages n'est PAS dupliqué ici : le journal de l'école vit
# dans Supabase (table whatsapp_messages). Garder ces deux valeurs à false
# évite de payer du stockage Railway pour une copie inutile.
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false

# --- Cache --------------------------------------------------------------------
# Une seule instance, un seul réplica : le cache mémoire suffit. Activer Redis
# ajouterait un troisième service à payer sans rien apporter à cette échelle.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# --- Session WhatsApp ---------------------------------------------------------
# Nom affiché dans WhatsApp → Appareils connectés, sur le téléphone de l'école.
CONFIG_SESSION_PHONE_CLIENT=BENZAOUI SCHOOL
CONFIG_SESSION_PHONE_NAME=Chrome

# Nombre de QR régénérés avant abandon. Chaque clic sur « Nouveau QR code »
# dans l'application en consomme un.
QRCODE_LIMIT=30

LOG_LEVEL=ERROR
# Une instance déconnectée n'est pas supprimée : la reconnexion se fait par un
# simple rescan, sans tout reconfigurer.
DEL_INSTANCE=false

# Les webhooks sont déclarés PAR INSTANCE depuis l'application
# (Paramètres → WhatsApp → Initialiser), avec le jeton d'authentification.
WEBHOOK_GLOBAL_ENABLED=false
